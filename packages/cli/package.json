{
  "name": "@relay-dx/cli",
  "version": "0.1.2",
  "description": "Extract the effective GraphQL schema from a Relay project",
  "homepage": "https://github.com/horusdotdev/relay-dx#readme",
  "bugs": {
    "url": "https://github.com/horusdotdev/relay-dx/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/horusdotdev/relay-dx.git",
    "directory": "packages/cli"
  },
  "bin": {
    "relay-schema": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "build:js": "vp pack"
  },
  "dependencies": {
    "@relay-dx/schema": "workspace:*"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
