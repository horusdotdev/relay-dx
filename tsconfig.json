{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@relay-dx/schema": ["./packages/schema/src/index.ts"],
      "@relay-dx/mcp": ["./packages/mcp/src/index.ts"],
      "@relay-dx/store": ["./packages/store/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts", "vite.config.ts"],
  "exclude": ["**/node_modules", "**/dist", "tests/fixtures"]
}
